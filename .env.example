# Copy to .env (local) — or add these as Codespaces secrets in GitHub.
# Leave both tokens empty to run the demo workspace.

# Slack: api.slack.com/apps -> your app -> OAuth & Permissions -> Bot User OAuth Token
SLACK_BOT_TOKEN=
# Optional: your own Slack user token (xoxp-...), same app -> OAuth & Permissions -> User OAuth Token.
# User Token Scopes: users.profile:write, users:write, dnd:write, dnd:read, channels:read, groups:read
# Lets HQ set your Slack status when you change it in HQ, list your channels (private too), and see your Pause notifications.
SLACK_USER_TOKEN=
# ClickUp: Settings -> Apps -> API Token
CLICKUP_API_TOKEN=
# Optional: which ClickUp workspace (number in the ClickUp URL). Defaults to the first one.
CLICKUP_TEAM_ID=
# Optional: only sync these lists or spaces (comma-separated ids). Default: whole workspace.
CLICKUP_LIST_IDS=
CLICKUP_SPACE_IDS=
# Optional: where "Give instruction" and the command bar create tasks.
CLICKUP_DEFAULT_LIST_ID=

# Your email (same in Slack and ClickUp) so HQ knows which person is you.
OWNER_EMAIL=
# Password for the web UI. Set this before making the Codespaces port public.
HQ_PASSWORD=

# Optional
# DEPARTMENTS=anna@acme.com=Sales;ben@acme.com=Design
# SLACK_ONLY_MATCHED=true    # only show Slack people who also have a ClickUp account
# POLL_SECONDS=60
# PUBLIC_URL=               # auto-detected in Codespaces

# Optional: Google Calendar in the clock dropdown. Google Cloud console -> APIs & Services -> Credentials ->
# OAuth client ID (Web application), redirect URI http://localhost:3000/auth/google/callback. Enable the Google Calendar API.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
